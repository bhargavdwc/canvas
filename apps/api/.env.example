# Render API Environment Variables
# In Render Dashboard -> Environment:

NODE_ENV=production
HOST=0.0.0.0
TRUST_PROXY=true
SESSION_SECRET=dev-only-session-secret-change-me-must-be-16-chars-min
CORS_ORIGIN=https://*.vercel.app,http://localhost:5173
ADMIN_TOKEN=your-admin-secret-token-min-16-chars

# Supabase Database credentials
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-service-or-anon-key

# Or direct Postgres (PostGIS) connection:
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres
